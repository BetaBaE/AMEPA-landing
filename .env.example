# Copier en .env.local (jamais versionné). Sans ces valeurs, le site tourne avec le contenu de départ.

# Adresse publique du site, sans / final
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# « true » uniquement en production, une fois le contenu validé : ouvre le site aux moteurs de recherche
SITE_INDEXABLE=false

# Sanity (sanity.io/manage, projet créé avec un compte de l'AMEPA)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Jeton « Editor » : enregistre les formulaires dans « Demandes reçues »
SANITY_API_WRITE_TOKEN=
# Secret du webhook de publication (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# E-mail des formulaires (resend.com, domaine vérifié)
RESEND_API_KEY=
FORMS_FROM_EMAIL=
# Une ou plusieurs adresses, séparées par des virgules
FORMS_TO_EMAIL=

# Photos (unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=
